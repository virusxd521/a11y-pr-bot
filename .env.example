# --- LLM (both Action and App) ---
# Use EITHER OpenAI or OpenRouter. Without a key the bot runs eslint-only.
# Option A — OpenAI (default endpoint):
OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# Option B — OpenRouter:
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# Advanced: point at any OpenAI-compatible host
# LLM_BASE_URL=https://...

# --- GitHub App only (npm run app) ---
# Leave these blank on first run: `npm run app` opens a setup flow that
# registers the App and fills them in for you.
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# Optional behaviour
A11Y_MIN_SEVERITY=serious
A11Y_FAIL_ON=none
A11Y_GLOBS=**/*.{jsx,tsx}
