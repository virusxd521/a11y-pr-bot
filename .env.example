# --- LLM (both Action and App) ---
# Without these the bot still runs in eslint-only (degraded) mode.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# --- GitHub App only (npm run app) ---
# Leave these blank on first run: `npm run app` opens a setup flow that
# registers the App and fills them in for you.
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# Optional behaviour
A11Y_MIN_SEVERITY=serious
A11Y_FAIL_ON=none
A11Y_GLOBS=**/*.{jsx,tsx}
