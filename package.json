{
  "name": "a11y-pr-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QODO-style GitHub bot that reviews pull requests for accessibility (a11y) violations and posts inline + summary comments.",
  "scripts": {
    "review": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
